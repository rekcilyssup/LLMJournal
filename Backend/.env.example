# Database: PostgreSQL (recommended for production) or SQLite for local testing
# PostgreSQL: postgresql://journal_user:journal_password_123@localhost:5432/llm_journal
# SQLite: sqlite:///./journal.db
DATABASE_URL=postgresql://journal_user:journal_password_123@localhost:5432/llm_journal

LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b
CLOUD_LLM_MODEL=cloud-model
CLOUD_LLM_API_KEY=
BACKEND_CORS_ORIGINS=http://localhost:3000
